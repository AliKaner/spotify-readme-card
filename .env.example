# Convex — created by `npx convex dev` (writes these automatically), do not set by hand
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Spotify Developer App — https://developer.spotify.com/dashboard
# Redirect URI: <NEXT_PUBLIC_CONVEX_SITE_URL... actually our own app>/api/connect/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AES-256-GCM key used to encrypt stored OAuth tokens at rest (32 random bytes, base64)
# generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# HMAC secret signing the Spotify "connect" OAuth CSRF state (32 random bytes, base64)
# generate with: openssl rand -base64 32
OAUTH_STATE_SECRET=

# Used for SEO/social meta tags, building embed URLs, and the OAuth state signature
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Convex deployment env vars (set via `npx convex env set NAME value`, NOT here) ---
# AUTH_GITHUB_ID       — GitHub OAuth App client ID
# AUTH_GITHUB_SECRET   — GitHub OAuth App client secret
# SITE_URL             — this app's origin, used for the post-login redirect
# (JWT_PRIVATE_KEY / JWKS were generated and set automatically by `npx @convex-dev/auth`)
